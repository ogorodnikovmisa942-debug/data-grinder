# Токен бота Telegram (от @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# База данных SQLite
DATABASE_URL="sqlite:///./data_grinder.db"

# Основной AI провайдер (deepseek или gemini)
AI_PROVIDER="deepseek"

# Настройки DeepSeek
DEEPSEEK_API_KEY="sk-ваш_ключ_deepseek"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Запасной Gemini (если используется)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# URL веб-приложения
WEBAPP_URL="https://datagrinder.site"
