# Токен бота Telegram (от @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# База данных SQLite
DATABASE_URL="sqlite:///./data_grinder.db"

# Основной AI провайдер (deepseek или gemini)
AI_PROVIDER="deepseek"

# Настройки DeepSeek
DEEPSEEK_API_KEY="sk-ваш_ключ_deepseek"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Настройки Xiaomi MiMo (1M Context, 128K Output)
MIMO_API_KEY="tp-ваш_ключ_mimo"
MIMO_MODEL="mimo-v2.5"
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"

# Запасной Gemini (если используется)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# URL веб-приложения
WEBAPP_URL="https://datagrinder.site"

# Администрирование эксперимента и бота
ADMIN_TELEGRAM_ID=""  # Ваш Telegram ID (число, например 1222282942), можно через запятую
ADMIN_TOKEN="secret-admin-token" # Токен для доступа к /api/admin/
