# Токен бота Telegram (от @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# База данных SQLite / PostgreSQL (Dual-Engine)
# Для SQLite: sqlite+aiosqlite:///./data_grinder.db
# Для PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/datagrinder
DATABASE_URL="sqlite+aiosqlite:///./data_grinder.db"

# Основной AI провайдер (deepseek или gemini)
AI_PROVIDER="deepseek"

# Настройки DeepSeek
DEEPSEEK_API_KEY="sk-ваш_ключ_deepseek"
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Запасной Gemini (если используется)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# URL веб-приложения
WEBAPP_URL="https://datagrinder.site"

# Администрирование эксперимента и бота
ADMIN_TELEGRAM_ID=""  # Ваш Telegram ID (число, например 1222282942), можно через запятую
ADMIN_TOKEN="CHANGE_ME_TO_RANDOM_STRING"  # ОБЯЗАТЕЛЬНО ЗАМЕНИТЕ на случайную строку!
